<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ContentTargetFolders>.</ContentTargetFolders>
		<Product>Our.Umbraco.HeadlessPreview</Product>
		<PackageId>Our.Umbraco.HeadlessPreview</PackageId>
		<Title>Our.Umbraco.HeadlessPreview</Title>
		<Description>This package adds a headless/alternative preview option to the Umbraco backoffice and lets you configure the preview url.</Description>
		<PackageTags>umbraco-marketplace; umbraco; preview; headless</PackageTags>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/jesperweber/Our.Umbraco.HeadlessPreview</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jesperweber/Our.Umbraco.HeadlessPreview</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="17.0.0" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="17.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="App_Plugins\Our.Umbraco.HeadlessPreview\**\*.*">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
		<None Include="build\**\*.*">
			<Pack>True</Pack>
			<PackagePath>buildTransitive</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings-schema.headlessPreview.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- Exclude the TypeScript client sources from the C# compilation/pack -->
	<ItemGroup>
		<Content Remove="Client\**" />
		<None Remove="Client\**" />
		<Compile Remove="Client\**" />
	</ItemGroup>
</Project>
