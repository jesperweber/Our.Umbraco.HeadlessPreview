<Project Sdk="Microsoft.NET.Sdk">
	<!-- [CHANGE: Umbraco 17 upgrade - single net10 target] Related: PreviewApiController.cs, PreviewComposer.cs, HeadlessPreviewUrlProvider.cs -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<ContentTargetFolders>.</ContentTargetFolders>
		<Product>Our.Umbraco.HeadlessPreview</Product>
		<PackageId>Our.Umbraco.HeadlessPreview</PackageId>
		<!-- [CHANGE: Umbraco 17 upgrade - prerelease version] Related: documentation/UPGRADE-TO-UMBRACO-17.md -->
		<Version>17.0.0-alpha000</Version>
		<Title>Our.Umbraco.HeadlessPreview</Title>
		<Description>This package adds a headless/alternative preview option to the Umbraco backoffice and lets you configure the preview url.</Description>
		<PackageTags>umbraco-marketplace; umbraco; preview; headless</PackageTags>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/jesperweber/Our.Umbraco.HeadlessPreview</PackageProjectUrl>
		<RepositoryUrl>https://github.com/jesperweber/Our.Umbraco.HeadlessPreview</RepositoryUrl>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.Cms.Web.Common" Version="[17.0.0,17.9.9)" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="[17.0.0,17.9.9)" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="App_Plugins\Our.Umbraco.HeadlessPreview\**\*.*">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
		<None Include="build\**\*.*">
			<Pack>True</Pack>
			<PackagePath>buildTransitive</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Content Include="appsettings-schema.headlessPreview.json" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!-- Exclude the TypeScript client sources from the C# compilation/pack -->
	<ItemGroup>
		<Content Remove="Client\**" />
		<None Remove="Client\**" />
		<Compile Remove="Client\**" />
	</ItemGroup>
</Project>
